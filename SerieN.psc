Algoritmo SerieN
	
	Definir cantidadTerminos, contadorNumeros, termino Como Entero
	
	Imprimir  "Ingresa su numero: "
	Leer cantidadTerminos
	
	contadorNumeros = 0
	termino = 1
	
	Mientras contadorNumeros < cantidadTerminos
		Escribir  termino, " "
		termino = termino + 2
		contadorNumeros = contadorNumeros + 1
	FinMientras
	
FinAlgoritmo
